[Unit]
Description=Coupax Board Flask App
After=network.target

[Service]
User=opc
Group=opc
WorkingDirectory=/home/opc/coupax-homepage/board
EnvironmentFile=/home/opc/coupax-homepage/board/.env
ExecStart=/home/opc/coupax-homepage/board/.venv/bin/gunicorn -w 3 -b 127.0.0.1:5001 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
