server {
    listen 80;
    server_name coupax.co.kr www.coupax.co.kr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name coupax.co.kr www.coupax.co.kr;

    ssl_certificate /etc/letsencrypt/live/coupax.co.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/coupax.co.kr/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    gzip on;
    gzip_types text/css application/javascript application/json text/plain;
    gzip_min_length 1000;

    limit_req_zone $binary_remote_addr zone=shorts_api:10m rate=3r/m;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /ads.txt {
        proxy_pass http://127.0.0.1:5001/ads.txt;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        add_header Cache-Control "public, max-age=900" always;
    }

    location /static {
        alias /home/ubuntu/coupax-homepage/board/static;
        add_header Cache-Control "public, max-age=300" always;
    }

    location /api/v1/shorts/ {
        limit_req zone=shorts_api burst=1 nodelay;
        client_max_body_size 32k;
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "private, no-cache, must-revalidate" always;
    }
}
