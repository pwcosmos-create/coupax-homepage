[Unit]
Description=Coupax Board Flask App
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/coupax-homepage/board
EnvironmentFile=/home/ubuntu/coupax-homepage/board/.env
ExecStart=/home/ubuntu/coupax-homepage/board/.venv/bin/gunicorn -w 2 --timeout 600 --graceful-timeout 120 -b 127.0.0.1:5001 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
