FLASK_SECRET_KEY=change-this-long-random-string
SESSION_COOKIE_SECURE=1
BLOG_WRITE_OPEN=0
COMMENT_MIN_INTERVAL_SEC=30
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false
BOARD_DB_PATH=/home/opc/coupax-homepage/board/board.db
SITE_NAME=머니인사이트
SITE_CONTACT_EMAIL=admin@coupax.co.kr
ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# 홈 질문창 즉시 답변 작성자 (기본: 젬마24)
# HOME_QA_REPLY_AUTHOR=젬마24

# 젬마24 페쇄형 답변 — 로컬 Ollama + gemma_knowledge.json (인터넷 불필요)
GEMMA_OLLAMA_ENABLED=1
GEMMA_OLLAMA_URL=http://127.0.0.1:11434/api/generate
GEMMA_OLLAMA_MODEL=etf_gemma:2b
GEMMA_OLLAMA_TIMEOUT_SEC=45
# 외부 OpenAI는 기본 끔 (1 일 때만 보조 사용)
HOME_QA_USE_OPENAI=0

# 사주 학습 카드 — PASS 후 Gemini 2.5로 해설 본문 1회 작성 (템플릿 초안 → Gemini)
# 카드 JSON의 llm_composed_at 이 있으면 Gemini/Ollama 재호출 안 함(저장본 재사용). 상세: deploy/README_SAJU_CARDS.md
SAJU_COMPOSE_LLM=1
SAJU_CARD_LLM_PROVIDER=gemini
SAJU_COMPOSE_LLM_SCOPE=interpretive
# Google AI Studio — **board 전용** (coupax_app 키와 분리, git 커밋 금지)
GEMINI_API_KEY=
SAJU_CARD_GEMINI_MODEL=gemini-2.5-flash
SAJU_CARD_GEMINI_TIMEOUT_SEC=120
SAJU_CARD_GEMINI_MAX_TOKENS=12000
# Gemini 전용 (Groq·Ollama 폴백 없음). 1이면 예외적으로 Ollama 허용
SAJU_CARD_LLM_ALLOW_OLLAMA_FALLBACK=0
SAJU_CARDS_PER_MINUTE=2
SAJU_CARDS_SLEEP_SEC=28

# 에이전트 사무실 — 대표님·젬마24 전용 비공개 (/agents/office/login)
AGENT_OFFICE_ACCESS_PASSWORD=change-this-office-password
# ON/OFF 제어 (사무실 입장 후, POST /api/agents/office/mode 헤더 X-Office-Token)
AGENT_OFFICE_CONTROL_TOKEN=change-this-office-token
AGENT_OFFICE_WORKER_ENABLED=1
# 탐정 젬마 웹 팩트 수집 (작업 지시·fact_pulse) — 젬마24 홈 답변과 별도
AGENT_OFFICE_WEB_SEARCH_ENABLED=1
AGENT_OFFICE_WEB_SEARCH_MAX=5
AGENT_OFFICE_WEB_TOPIC_ENABLED=1
AGENT_OFFICE_WEB_TOPIC_MAX=3
# AGENT_OFFICE_WEB_SEARCH_TIMEOUT_SEC=25
# AGENT_OFFICE_WEB_PULSE_ENABLED=0   (1이면 fact_pulse 주기마다 웹 2건 스냅샷)
# TAVILY_API_KEY=tvly-xxxxxxxx          (권장 — 한국 금융 뉴스 품질)
# BRAVE_SEARCH_API_KEY=BSAxxxxxxxx      (Tavily 없을 때)

# 원키스 US 학습 카드 — 0=제작·시드·ATR RL 중지 (기본). 재개 시 1
WORKISUS_CARD_PRODUCTION=0
# wonkisus 매매 정본 Wiki (gemma24/10_Wiki)
# WONKISUS_WIKI_RULES_PATH=/home/opc/wonkisus/gemma24/10_Wiki/wonkisus-grid-trading-rules.md

# pwcosmos-swiki GitHub 지식 동기화 (10_Wiki/Topics/Coupax)
SWIKI_SYNC_ENABLED=0
SWIKI_GIT_URL=https://github.com/pwcosmos-create/pwcosmos-swiki.git
SWIKI_GIT_BRANCH=main
# SWIKI_GIT_TOKEN=ghp_xxxxxxxx  (push 권한 PAT — 서버 .env 만)
# SWIKI_REPO_PATH=data/pwcosmos-swiki
AGENT_OFFICE_SUBPROCESS_TIMEOUT=600
# 작업 완료 시 블로그 초안 자동 생성 (is_draft=1, 목록 미노출)
AGENT_OFFICE_BLOG_DRAFT_ENABLED=1
# AGENT_OFFICE_BLOG_DRAFT_PASSWORD=coupax2026
# AGENT_OFFICE_BLOG_AUTHOR=머니인사이트
# 블로그 순차 발행 — 하루 1건·랜덤 시각·AdSense 보강 후 공개
BLOG_SCHEDULED_PUBLISH_ENABLED=1
BLOG_PUBLISH_MANUAL_BLOCK=1
BLOG_PUBLISH_TZ=Asia/Seoul
BLOG_PUBLISH_HOUR_START=8
BLOG_PUBLISH_HOUR_END=21
BLOG_ADSENSE_MIN_CHARS=1500
# 발행 중복 제외 — 공개글 제목·본문 유사도
BLOG_PUBLISH_DEDUP_LOOKBACK=400
BLOG_PUBLISH_DEDUP_TITLE_SIM=0.82
BLOG_PUBLISH_DEDUP_BODY_SIM=0.52
# 조사·시황 → 블로그 초안 1건/일 (발행은 BLOG_SCHEDULED_PUBLISH)
BLOG_RESEARCH_DRAFT_ENABLED=1
# BLOG_RESEARCH_DRAFT_PREFER=both
# 종목 시리즈(하루 1종목 글 + 매일 댓글) — 종합 조사 글과 동시 쓰면 하루 2건 발행됨 → 하나만 1 권장
BLOG_STOCK_SERIES_ENABLED=1
BLOG_STOCK_SERIES_PER_DAY=2
# BLOG_RESEARCH_DRAFT_ENABLED=0
# BLOG_STOCK_SERIES_TRACK_DAYS=30
# BLOG_STOCK_SERIES_COMMENT_AUTHOR=시황일지
# BLOG_STOCK_SERIES_MIN_COMMENT_CHARS=500
# BLOG_STOCK_SERIES_AGENT_RESEARCH=1
# BLOG_STOCK_SERIES_FORCE_AGENTS=1
# both | task | stock — 사무실 완료 작업 우선, 없으면 주식 시황부
# 사무실 폼 지시 → Cursor 인박스 (CURSOR_OFFICE_INBOX.md)
AGENT_OFFICE_CURSOR_BRIDGE=1

# 주식 시황부 — 국내·미국 시세 스냅샷 (Yahoo chart API, 키 불필요)
STOCK_WATCH_ENABLED=1
# 국내 KOSPI200·KOSDAQ150 (시총 순, 네이버 — 지수 공식 편입과 소폭 차이 가능)
STOCK_WATCH_KR_UNIVERSE=1
# STOCK_WATCH_KOSPI200_LIMIT=200
# STOCK_WATCH_KOSDAQ150_LIMIT=150
# STOCK_WATCH_KR_INDEX_SYMBOLS=^KS11,^KQ11
# STOCK_WATCH_KR_WORKERS=6
# STOCK_WATCH_US_SYMBOLS=^GSPC,^IXIC,^DJI,AAPL,MSFT,NVDA,AMZN
# STOCK_WATCH_ALERT_PCT=2.0
# STOCK_WATCH_FETCH_DELAY_SEC=0.2
# 증시 댓글 교차 검증 (웹 2회 + 시세 스냅샷)
# STOCK_COMMENT_VERIFY_MAX=6
# STOCK_COMMENT_VERIFY_ON_SYNC=1
# STOCK_OFFICIAL_ON_SYNC=1
# DART_API_KEY=              # opendart.fss.or.kr — 있으면 공시 API로 종목별 최근 공시
# STOCK_MACRO_ON_SYNC=1      # 지금 수집 시 금리·달러·원자재·채권·원유·CEO 조사 포함 (official 묶음)
# STOCK_CEO_WATCH_LIMIT=5    # CEO 멘트 검색 종목 수 (변동 큰 관심종목 우선)
# STOCK_YOUTUBE_WATCH_LIMIT=4  # 유튜브 종목별 검색 수
# STOCK_ANALYST_WATCH_LIMIT=6  # 애널리스트 리포트 검색 종목 수
# YOUTUBE_API_KEY=           # Google YouTube Data API v3 (있으면 유튜브 검색 품질↑)

# 키움 차수거래 — 계좌 젬마 잔고 스냅샷 (사무실 UI 또는 JSON 파일 갱신)
# KIWOM_ACCOUNT_STALE_HOURS=36
# KIWOM_ACCOUNT_IMPORT_PATH=/path/to/kiwoom_balance.json

# 원히어로 실매매 bot_log → 차수거래 학습 카드 모니터 (kisstock SQLite)
# WONHERO_MONITOR_ENABLED=1
# WONHERO_SQLITE_PATH=/home/ubuntu/kisstock/trade_history.sqlite
# WONHERO_MONITOR_MAX_CARDS=4
# WONHERO_MONITOR_AUTO_CONFIRM=1

# ETF 파이프라인·공개 페이지 — 기본 0(전면 중단). 1 일 때만 /etf·시트·sync 동작
COUPAX_ETF_ENABLED=0

# 관상 학습 — RL/Gemini 카드 자동 제작 (카탈로그 갭 후 확장 토픽)
GWANSANG_COMPOSE_LLM=1
# GWANSANG_RL_MAX_ADD=2
# GWANSANG_GAP_MAX_ADD=2
# GWANSANG_CARD_GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=              # Google AI Studio (사주·관상 카드 Gemini 공용)
# search-etf.com API — COUPAX_ETF_ENABLED=1 이어도 기본 0(중단)
SEARCH_ETF_CALLS_ALLOWED=0
